1406080e8c39bc2c730304c3a1e5f4959e4efaf2146c0a7d9\",\"format\":\"presentation-protobuf\",\"byteLength\":2041547},\"publisher\":\"openai\",\"title\":\"Growth Strategy\"},{\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/calder-architecture/31c579bbb25942f4b7c0202187e658de59f6e51418f677011f8388820110fb5c/cover.png\",\"id\":\"calder-architecture\",\"source\":{\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/calder-architecture/31c579bbb25942f4b7c0202187e658de59f6e51418f677011f8388820110fb5c/presentation.pb\",\"sha256\":\"e02f2ed446d33db1ee1e79911b9ddd417d01ba5044c694e131c5fe4a5e85b70b\",\"format\":\"presentation-protobuf\",\"byteLength\":3971811},\"title\":\"Calder Architecture\",\"publisher\":\"openai\",\"revision\":\"31c579bbb25942f4b7c0202187e658de59f6e51418f677011f8388820110fb5c\"},{\"source\":{\"format\":\"presentation-protobuf\",\"byteLength\":5028803,\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/annual-impact-report/19f8ff724a5fc380516f68121fcee318f306e06ac27035a3001ab5ed425a53d1/presentation.pb\",\"sha256\":\"2e55406954bb3ad6f35b91e01f1e3193df4efb55ee5be8cc74dccb474f5be2c8\"},\"id\":\"annual-impact-report\",\"publisher\":\"openai\",\"revision\":\"19f8ff724a5fc380516f68121fcee318f306e06ac27035a3001ab5ed425a53d1\",\"title\":\"Annual Impact Report\",\"thumbnailUrl\":\"https://persistent.oaistatic.com/space-presentation-templates/annual-impact-report/19f8ff724a5fc380516f68121fcee318f306e06ac27035a3001ab5ed425a53d1/cover.png\"},{\"title\":\"Creative Campaign Brief\",\"publisher\":\"openai\",\"source\":{\"format\":\"presentation-protobuf\",\"sha256\":\"a58f76123b9e78c508f12663f0a8db9c887a0df182b40b4dd696b425609b7682\",\"byteLength\":3131298,\"url\":\"https://persistent.oaistatic.com/space-presentation-templates/creative-campaign-brief/03036308b09ad8a72f593b77ed9ac88a53392fe15b2f81bbd8c0c6ee497810e9/presentation.pb\"},\"revision\":\"03036308b09ad8a72f593b77ed9ac88a53392fe15b2f81bbd8c0c6ee